# ══════════════════════════════════════════════════════════════
#  n8n — Imagem oficial com SSL habilitado para Render
#  Não edite este arquivo manualmente.
#  Todas as configs ficam nas variáveis de ambiente do render.yaml.
# ══════════════════════════════════════════════════════════════
FROM n8nio/n8n:latest

# Garante que o container rode como root para permissões no Render
USER root

# Variável de ambiente para aceitar SSL do PostgreSQL da Render
ENV NODE_TLS_REJECT_UNAUTHORIZED=0

# Porta padrão do n8n
EXPOSE 5678
