# ══════════════════════════════════════════════════════════════
#  n8n — Render Web Service (Docker)
#  A Render injeta $PORT em runtime; o CMD shell-form expande
#  a variável DEPOIS que o container sobe, garantindo que o n8n
#  escute exatamente na porta que a Render espera.
# ══════════════════════════════════════════════════════════════
FROM n8nio/n8n:latest

USER root

# Aceita SSL do PostgreSQL interno da Render
ENV NODE_TLS_REJECT_UNAUTHORIZED=0

# CMD em shell-form: o sh é invocado em runtime (quando $PORT já existe)
# ENTRYPOINT exec-form não expande variáveis — por isso não usamos aqui.
CMD sh -c "export N8N_PORT=${PORT:-5678} && export N8N_LISTEN_ADDRESS=0.0.0.0 && n8n start"
