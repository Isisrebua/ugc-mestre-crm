# ══════════════════════════════════════════════════════════════
#  UGC Mestre CRM — Variáveis de Ambiente
#  Copie este arquivo para '.env' e preencha com seus valores reais.
#  NUNCA suba o arquivo '.env' para o Git (já está no .gitignore).
# ══════════════════════════════════════════════════════════════

# ── Banco de Dados ─────────────────────────────────────────────
# URL de conexão com o banco principal (Supabase ou NocoDB na Render)
# Exemplo Supabase:  postgresql://postgres:[SENHA]@db.[ID].supabase.co:5432/postgres
# Exemplo NocoDB:    https://[SUA-INSTANCIA].onrender.com
DATABASE_URL=

# Chave de API do Supabase (anon key — pública) ou NocoDB (token de acesso)
API_KEY=

# Chave de serviço do Supabase (service role — NUNCA exponha no frontend)
# Usada apenas em funções serverless ou webhooks do n8n
SUPABASE_SERVICE_KEY=

# ── n8n (Automação / Agentes) ───────────────────────────────────
# URL base da instância do n8n hospedada na Render
N8N_BASE_URL=https://n8n-ugc-mestre.onrender.com

# Webhook de entrada para acionar o Agente 1 (Pré-Lista)
N8N_WEBHOOK_AGENTE1=

# Webhook de entrada para acionar o Agente 2 (Cadência)
N8N_WEBHOOK_AGENTE2=

# Webhook de entrada para acionar o Agente Atendente (respostas)
N8N_WEBHOOK_ATENDENTE=

# Chave secreta compartilhada para autenticar chamadas entre o CRM e o n8n
N8N_SECRET_KEY=

# ── App ────────────────────────────────────────────────────────
# Ambiente de execução: 'production' ou 'development'
NODE_ENV=production

# URL pública do CRM na Render (após o deploy)
APP_URL=https://ugc-mestre.onrender.com
